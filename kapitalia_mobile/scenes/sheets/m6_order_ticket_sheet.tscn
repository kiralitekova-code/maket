[gd_scene load_steps=1 format=3]

[node name="M6OrderTicket" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2

# ── Заголовок ──
[node name="HeaderRow" type="HBoxContainer" parent="VBox"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="HeaderVBox" type="VBoxContainer" parent="VBox/HeaderRow"]
layout_mode = 1
size_flags_horizontal = 3

[node name="TitleRow" type="HBoxContainer" parent="VBox/HeaderRow/HeaderVBox"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="StatusDot" type="Label" parent="VBox/HeaderRow/HeaderVBox/TitleRow"]
layout_mode = 1
text = "●"
theme_override_colors/font_color = Color(0.176, 0.831, 0.749, 1)

[node name="SheetTitle" type="Label" parent="VBox/HeaderRow/HeaderVBox/TitleRow"]
