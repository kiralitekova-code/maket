[gd_scene load_steps=1 format=3]

[node name="M8Alerts" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Scroll"]
layout_mode = 2

# Заголовок экрана + бейдж критичности + кнопка «Прочитать все»
[node name="HeaderRow" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="SectionTitle" type="Label" parent="Scroll/VBox/HeaderRow"]
layout_mode = 1
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "Оперативные события"

[node name="CritBadge" type="PanelContainer" parent="Scroll/VBox/HeaderRow"]
layout_mode = 1
custom_minimum_size = Vector2(0, 26)

[node name="CritBadgeLabel" type="Label" parent="Scroll/VBox/HeaderRow/CritBadge"]
layout_mode = 1
text = "3 КРИТ"
theme_override_colors/font_color = Color(1, 0.333, 0.353, 1)
theme_override_font_sizes/font_size = 11

[node name="MarkAllBtn" type="Button" parent="Scroll/VBox/HeaderRow"]
layout_mode = 1
text = "✓ Прочитать все"
custom_minimum_size = Vector2(0, 44)

# Фильтры-чипы (горизонтальный скролл)
[node name="ChipScroll" type="ScrollContainer" parent="Scroll/VBox"]
layout_mode = 1
horizontal_scroll_mode = 2
vertical_scroll_mode = 0

[node name="ChipRow" type="HBoxContainer" parent="Scroll/VBox/ChipScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ChipAll" type="Button" parent="Scroll/VBox/ChipScroll/ChipRow"]
layout_mode = 1
text = "Все · 12"
custom_minimum_size = Vector2(0, 40)
size_flags_vertical = 0

[node name="ChipCritical" type="Button" parent="Scroll/VBox/ChipScroll/ChipRow"]
layout_mode = 1
text = "Критические · 3"
custom_minimum_size = Vector2(0, 40)
size_flags_vertical = 0

[node name="ChipSupply" type="Button" parent="Scroll/VBox/ChipScroll/ChipRow"]
layout_mode = 1
text = "Поставки · 4"
custom_minimum_size = Vector2(0, 40)
size_flags_vertical = 0

[node name="ChipMarket" type="Button" parent="Scroll/VBox/ChipScroll/ChipRow"]
layout_mode = 1
text = "Рынок · 3"
custom_minimum_size = Vector2(0, 40)
size_flags_vertical = 0

[node name="ChipSystem" type="Button" parent="Scroll/VBox/ChipScroll/ChipRow"]
layout_mode = 1
text = "Система · 2"
custom_minimum_size = Vector2(0, 40)
size_flags_vertical = 0

# Приоритетный баннер / тактическая сводка
[node name="PriorityBanner" type="PanelContainer" parent="Scroll/VBox"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="BannerInner" type="HBoxContainer" parent="Scroll/VBox/PriorityBanner"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="BannerIcon" type="Label" parent="Scroll/VBox/PriorityBanner/BannerInner"]
layout_mode = 1
text = "⚠️"
custom_minimum_size = Vector2(36, 36)

[node name="BannerTextVBox" type="VBoxContainer" parent="Scroll/VBox/PriorityBanner/BannerInner"]
layout_mode = 1
size_flags_horizontal = 3

[node name="BannerTitle" type="Label" parent="Scroll/VBox/PriorityBanner/BannerInner/BannerTextVBox"]
layout_mode = 1
text = "2 завода требуют вмешательства"

[node name="BannerSub" type="Label" parent="Scroll/VBox/PriorityBanner/BannerInner/BannerTextVBox"]
layout_mode = 1
theme_override_colors/font_color = Color(0.392, 0.455, 0.545, 1)
theme_override_font_sizes/font_size = 11
text = "Остановка конвейеров через ~1 такт"

